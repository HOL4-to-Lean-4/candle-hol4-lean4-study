# Build outputs. Scoped so that vendor/ sources (e.g. HOL's src/postkernel/Theory.sml)
# are never ignored; vendor/ trees keep their own upstream .gitignore files.
/_build/
/logs/
/package/**/.hol/
/package/**/.HOLMK/
/package/**/*.uo
/package/**/*.ui
/package/**/*Theory.sml
/package/**/*Theory.sig
/package/**/*Theory.dat
/package/**/*.dat
/package/**/heap
/lean/**/.lake/
**/.lake/
__pycache__/
# Raw model transcripts (account details) and the scoring key (rebuilt by make_csv.py).
audit/**/runs/**/*.raw
audit/**/runs/**/*.err
audit/**/runs/**/*.last
*.jsonl.err
run_*.jsonl
/baselines/ts_runs_v2/scoring/key.csv
/audit/real/check/check_key.csv
